APP_NAME="AI Web Quality Analyzer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Several workers so the app can analyse its own address (http://127.0.0.1:8000).
# Only used with `php artisan serve --no-reload`.
PHP_CLI_SERVER_WORKERS=4

# No database is used: sessions and cache are plain files.
SESSION_DRIVER=file
CACHE_STORE=file
LOG_CHANNEL=single

# Ollama (local AI) on this computer — start it with `ollama serve` (or the ollama service).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=180

# Site profile: hosting country/provider is found from the site's IP address with this geolocation service.
# Only the IP address is sent. Set WEBQA_GEO_LOOKUP=false to turn it off.
WEBQA_GEO_LOOKUP=true
WEBQA_GEO_URL=https://ipwho.is/{ip}
